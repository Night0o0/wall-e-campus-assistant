{
  "name": "backend",
  "version": "1.0.0",
  "description": "WALL-E Campus Assistant Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "verify:seed": "tsx scripts/verify-seed-scratch.ts",
    "verify:seed:rollback": "tsx scripts/verify-seed-rollback.ts",
    "verify:auth": "tsx scripts/verify-supabase-auth.ts",
    "verify:academic-api": "tsx scripts/verify-academic-api.ts",
    "verify:database": "tsx scripts/verify-live-database.ts",
    "verify:registration": "tsx scripts/verify-registration.ts",
    "verify:web-session": "tsx scripts/verify-web-session.ts",
    "verify:mail": "tsx scripts/verify-mail.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "@supabase/supabase-js": "^2.112.4",
    "@types/nodemailer": "^8.0.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.10",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.1.1",
    "zod": "^3.25.67"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^26.1.2",
    "prisma": "^6.9.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "allowScripts": {
    "@prisma/client@6.16.2": true,
    "@prisma/engines@6.16.2": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.28.1": true,
    "prisma@6.16.2": true
  }
}
