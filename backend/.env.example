# Server
PORT=5000
NODE_ENV=development

# Auth
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters. The server refuses to start without it.
JWT_SECRET=replace-me-with-a-64-character-hex-string
JWT_EXPIRES_IN=7d

# Authentication cutover: legacy -> dual -> supabase.
# `dual` keeps existing local accounts working while authUserId is backfilled.
AUTH_PROVIDER=legacy
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server only. Required for administrator-created staff accounts; never expose
# this in Vite, Flutter, logs, or API responses.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Restricts GET /api/sessions/:id/qr to staff.
# Keep this true: students scan codes but must never mint them.
QR_ENDPOINT_STAFF_ONLY=true

# Whether a student may scan a session that has no lecture behind it.
# Scanning is bound to the student's own cohort: a session linked to a
# LectureSchedule is scannable only by the students that lecture is addressed
# to, read from their stored profile and never from the request. An ad-hoc
# session has no lecture and therefore no cohort to compare against, so there is
# nothing to check it by.
# Ships true, so makeup classes and one-off seminars keep working. Set to false
# once every session-opening path in use sends lectureScheduleId — at which
# point cohort binding is total. Flipping it early makes ad-hoc sessions
# unscannable on the day they are being held.
SCAN_ALLOW_UNLINKED_SESSIONS=true

# Attendance lifecycle
# A scan arriving later than this after attendance opened is LATE, not PRESENT.
# Measured from when the instructor opened the session, so a late start does not
# make the whole room late.
ATTENDANCE_LATE_AFTER_MINUTES=15

# Assumed length of a session with no timetable entry behind it. A session
# linked to a LectureSchedule takes its length from the lecture instead.
SESSION_DEFAULT_MINUTES=120

# How long an open session may outlive its lecture before the sweep closes it
# as AUTO_STALE. This is also the width of the PENDING window.
SESSION_STALE_GRACE_MINUTES=30

# Runs the sweep: auto-close stale sessions, then write ABSENT rows for closed
# ones. Set false on any replica that must not write attendance. While it is
# false no ABSENT row is ever created.
ATTENDANCE_WORKER_ENABLED=true
ATTENDANCE_SWEEP_INTERVAL_MS=300000

# Rate limits, per 15 minutes.
# Authenticated traffic is counted per principal (user or device), not per IP —
# a campus shares one NAT address, so an IP-keyed bucket would be exhausted by a
# single lecture hall scanning attendance together.
RATE_LIMIT_AUTHENTICATED=1000
RATE_LIMIT_ANONYMOUS=300
RATE_LIMIT_SCAN=30

# Billing (plans, subscriptions, invoices, payments, revenue metrics)
# Off during the campus pilot. Set to true to expose the billing API again.
# Keep this in sync with VITE_BILLING_ENABLED in apps/web.
BILLING_ENABLED=false

# Lecture notifications (Feature 3)
# The in-process reminder worker: generates reminders for upcoming lectures and
# delivers the ones that come due. Turn it off on any instance that must not
# send — a second replica, or a machine only serving the dashboard.
NOTIFICATION_WORKER_ENABLED=true

# The campus clock a lecture's "12:00" is read in. IANA zone name; daylight
# saving is handled from the zone's own rules.
NOTIFICATION_TIMEZONE=Africa/Cairo

# How far ahead reminders are generated, in minutes. Must exceed the longest
# lead time (24 hours) or the 24-hour reminder would be generated too late;
# raised automatically if set lower. 2880 = two days.
NOTIFICATION_HORIZON_MINUTES=2880

# How often the worker looks for due reminders, and how often it regenerates.
NOTIFICATION_POLL_INTERVAL_MS=60000
NOTIFICATION_GENERATION_INTERVAL_MS=900000

# Delivery back end. "log" writes each reminder to the server log, "none" keeps
# it in-app only. Firebase Cloud Messaging goes here when the Flutter client is
# wired up — see PushNotificationProvider.
PUSH_PROVIDER=log

# Exposes POST /api/notifications/dev/{generate,simulate,dispatch}, which create
# and deliver real reminders on demand. Ignored when NODE_ENV=production, where
# those routes are never mounted whatever this says.
NOTIFICATION_DEV_TOOLS=true

# Database (PostgreSQL)
# DATABASE_URL goes through the pooler, DIRECT_URL is used for migrations
DATABASE_URL=postgresql://user:password@host:5432/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# ─────────────────────────────── Email ──────────────────────────────────────
#
# Transactional mail. Student registration and password recovery both depend on
# real delivery, so unlike PUSH_PROVIDER this is not an optional channel:
# MAIL_PROVIDER=log is REFUSED at boot when NODE_ENV=production.
#
# "log"  — prints the message, one-time code included, to the server log.
#          Development and tests only.
# "smtp" — real delivery. SMTP_HOST becomes required.
MAIL_PROVIDER=log

# RFC 5322 From header. A display name is allowed.
MAIL_FROM=Wall-E Campus <no-reply@wall-e.local>

# SMTP_SECURE=true is implicit TLS on port 465. Port 587 negotiates STARTTLS
# and wants false. Leave SMTP_USER and SMTP_PASSWORD empty for a relay that
# authenticates by IP — empty credentials make some relays refuse outright.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ──────────────────────── One-time codes (OTP) ──────────────────────────────
#
# Six digits is one of a million, which is a good secret or a hopeless one
# depending entirely on the four limits below. They are a set: relax any one
# and the others stop being sufficient. See services/email-challenge.service.ts.
OTP_LENGTH=6
OTP_TTL_MINUTES=10

# Wrong guesses before the code is burned outright.
OTP_MAX_ATTEMPTS=5

# Minimum gap between two sends to the same address.
OTP_RESEND_COOLDOWN_SECONDS=60

# Codes one address may be sent per hour, counting BOTH purposes together.
# Without this, the attempt ceiling is defeated by requesting a fresh code
# after every fifth wrong guess.
OTP_MAX_PER_EMAIL_PER_HOUR=5

# OTP requests per 15 minutes from one IP. The outer, weaker throttle — a
# campus NAT shares this bucket, so it is set well above what one person needs.
RATE_LIMIT_OTP=20

# How long a proven email stays spendable at POST /api/auth/register.
REGISTRATION_TICKET_TTL_MINUTES=30

# Whether /api/auth/register demands a verification ticket.
#
# Ships OFF for the same reason QR_ENDPOINT_STAFF_ONLY does: the client that
# has to change is not in this repository. The Flutter student app registers
# with no ticket today, and turning this on before it implements the OTP
# screens would stop student registration outright. Turn it on once the app
# sends `verificationTicket`.
STUDENT_EMAIL_VERIFICATION_REQUIRED=false
