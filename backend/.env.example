# Server
PORT=5000
NODE_ENV=development

# Auth
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters. The server refuses to start without it.
JWT_SECRET=replace-me-with-a-64-character-hex-string
JWT_EXPIRES_IN=7d

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Billing (plans, subscriptions, invoices, payments, revenue metrics)
# Off during the campus pilot. Set to true to expose the billing API again.
# Keep this in sync with VITE_BILLING_ENABLED in apps/web.
BILLING_ENABLED=false

# Lecture notifications (Feature 3)
# The in-process reminder worker: generates reminders for upcoming lectures and
# delivers the ones that come due. Turn it off on any instance that must not
# send — a second replica, or a machine only serving the dashboard.
NOTIFICATION_WORKER_ENABLED=true

# The campus clock a lecture's "12:00" is read in. IANA zone name; daylight
# saving is handled from the zone's own rules.
NOTIFICATION_TIMEZONE=Africa/Cairo

# How far ahead reminders are generated, in minutes. Must exceed the longest
# lead time (24 hours) or the 24-hour reminder would be generated too late;
# raised automatically if set lower. 2880 = two days.
NOTIFICATION_HORIZON_MINUTES=2880

# How often the worker looks for due reminders, and how often it regenerates.
NOTIFICATION_POLL_INTERVAL_MS=60000
NOTIFICATION_GENERATION_INTERVAL_MS=900000

# Delivery back end. "log" writes each reminder to the server log, "none" keeps
# it in-app only. Firebase Cloud Messaging goes here when the Flutter client is
# wired up — see PushNotificationProvider.
PUSH_PROVIDER=log

# Exposes POST /api/notifications/dev/{generate,simulate,dispatch}, which create
# and deliver real reminders on demand. Ignored when NODE_ENV=production, where
# those routes are never mounted whatever this says.
NOTIFICATION_DEV_TOOLS=true

# Database (PostgreSQL)
# DATABASE_URL goes through the pooler, DIRECT_URL is used for migrations
DATABASE_URL=postgresql://user:password@host:5432/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres
