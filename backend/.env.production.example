PORT=5000
NODE_ENV=production
APP_VERSION=1.0.0
RELEASE_SHA=SET_TO_GIT_COMMIT
LOG_LEVEL=info
TRUST_PROXY_HOPS=1

JWT_SECRET=SET_IN_SECRET_MANAGER_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d
AUTH_PROVIDER=supabase
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=SET_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=SET_IN_SECRET_MANAGER
SUPABASE_JWT_AUDIENCE=authenticated

DATABASE_URL=SET_POOLED_POSTGRES_URL
DIRECT_URL=SET_DIRECT_POSTGRES_URL
CORS_ORIGINS=https://app.example.edu

SCAN_ALLOW_UNLINKED_SESSIONS=false
ATTENDANCE_LATE_AFTER_MINUTES=15
SESSION_DEFAULT_MINUTES=120
SESSION_STALE_GRACE_MINUTES=30
ATTENDANCE_WORKER_ENABLED=true
ATTENDANCE_SWEEP_INTERVAL_MS=300000
RATE_LIMIT_AUTHENTICATED=1000
RATE_LIMIT_ANONYMOUS=300
RATE_LIMIT_SCAN=30

NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_TIMEZONE=Africa/Cairo
NOTIFICATION_HORIZON_MINUTES=2880
NOTIFICATION_POLL_INTERVAL_MS=60000
NOTIFICATION_GENERATION_INTERVAL_MS=900000
PUSH_PROVIDER=none
NOTIFICATION_DEV_TOOLS=false

MAIL_PROVIDER=smtp
MAIL_FROM=Leornian Campus <no-reply@example.edu>
SMTP_HOST=SET_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=SET_IN_SECRET_MANAGER
SMTP_PASSWORD=SET_IN_SECRET_MANAGER

OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_EMAIL_PER_HOUR=5
RATE_LIMIT_OTP=20
REGISTRATION_TICKET_TTL_MINUTES=30
STUDENT_EMAIL_VERIFICATION_REQUIRED=false
