# API base URL. Leave unset in development — Vite proxies /api to the backend.
# VITE_API_URL=https://api.example.com/api

# Public Supabase browser configuration. The service-role key is server-only.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Billing UI (Revenue, Subscriptions, Plans, Invoices pages and every billing
# column, tile and chart). Off during the campus pilot.
# Must match BILLING_ENABLED in backend/.env — enabling one without the other
# leaves the console calling routes the API does not mount.
VITE_BILLING_ENABLED=false
