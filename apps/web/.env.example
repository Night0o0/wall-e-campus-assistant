# API base URL. Leave unset in development — Vite proxies /api to the backend.
# VITE_API_URL=https://api.example.com/api

# Public Supabase browser configuration. The service-role key is server-only.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Firebase App Distribution tester-invite link for the Android beta. NOT a
# secret and NOT a raw APK URL — the invite onboards testers to the latest
# distributed release. Must be an https URL; leave unset to hide the download
# button. Repoint it (and rebuild the static site) only when the invite link
# itself changes, not on every release. See docs/ANDROID_BETA_DISTRIBUTION.md.
# VITE_ANDROID_BETA_DOWNLOAD_URL=https://appdistribution.firebase.dev/i/your-invite-id
